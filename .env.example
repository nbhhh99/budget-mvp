# 오늘의 경제지표 자동 수집 스크립트(scripts/collect-indicators)와 재무 브리핑
# 수집 스크립트(scripts/collect-briefing)에서만 쓰는 서버 전용 값이다. 프론트엔드
# 코드에는 어떤 키도 포함되지 않고, 실제 값은 GitHub Actions 저장소 시크릿에만
# 등록한다(Settings → Secrets and variables → Actions). 이 파일은 값을 채우지 않은
# 예시일 뿐이며, 실제 키가 담긴 .env 파일은 절대 커밋하지 않는다.

# ── 오늘의 경제지표 (scripts/collect-indicators) ──────────────────────

# 한국수출입은행 환율정보 API 인증키. 발급: https://www.data.go.kr/data/3068846/openapi.do
# (공공데이터포털 회원가입 → 활용신청, 무료·즉시~단기 승인)
# 필수 여부: 환율(원/달러·원/100엔·원/유로) 자동 수집에 필요. 미설정 시 환율
# 카드가 "데이터 제공 준비 중"으로 표시되고, 나머지 지표는 정상 동작한다.
# 서버 전용: 예 (GitHub Actions Secrets에만 등록)
EXIMBANK_API_KEY=

# 한국석유공사 오피넷 Open API 인증키. 발급: https://www.data.go.kr/data/15150932/openapi.do
# 필수 여부: 국내 전국 평균 휘발유·경유 가격 자동 수집에 필요. 미설정 시 해당
# 카드만 "데이터 제공 준비 중"으로 표시된다.
# 서버 전용: 예
OPINET_API_KEY=

# 공공데이터포털(data.go.kr) 인증키. 아래 두 API에 각각 활용신청을 승인받아야 한다:
#  - 금융위원회_지수시세정보 (KOSPI·KOSDAQ) https://www.data.go.kr/data/15094807/openapi.do
#  - 금융위원회_일반상품시세정보(금시세 오퍼레이션, KRX 금시장) https://www.data.go.kr/data/15094805/openapi.do
# 필수 여부: 위 두 지표(국내 주식·국내 금) 자동 수집에 필요.
# 서버 전용: 예
# 한계: 이 세션에서는 API 존재·이용조건만 확인했고, 정확한 요청 엔드포인트는
# 활용신청 승인 후 활용가이드에서 직접 확인해야 한다(추측으로 채우지 않음—
# scripts/collect-indicators/sources/fscIndex.ts, fscCommodity.ts 스텁 참고).
# 키를 설정해도 해당 두 지표는 구현이 완료되기 전까지 계속 "준비 중"으로 남는다.
DATA_GO_KR_API_KEY=

# 미국 에너지정보청(EIA) Open Data API 키. 발급(무료): https://www.eia.gov/opendata/register.php
# 필수 여부: 선택. WTI·Brent 국제유가 자동 수집에 쓰려고 만들어둔 자리다. 두바이유는
# 공식 무료 API를 찾지 못해 이 프로젝트에서 지원하지 않는다.
# 서버 전용: 예
# 한계: 정확한 시리즈 ID(series id)를 이 세션에서 확인하지 못해 스텁 상태다
# (scripts/collect-indicators/sources/eiaOil.ts). 키를 설정해도 아직 동작하지 않는다.
EIA_API_KEY=

# Alpha Vantage(상업적 제공업체) API 키. 발급(무료): https://www.alphavantage.co/support/#api-key
# 필수 여부: 선택. 해외 주가지수(S&P 500·NASDAQ)와 국제 금 가격을 위해 검토한
# 대안 API다 — 공식 무료 정부 API를 찾지 못했다.
# 서버 전용: 예
# 한계: 무료 요금제의 정확한 호출 한도·엔드포인트를 이 세션에서 재확인하지 못해
# 스텁 상태다(scripts/collect-indicators/sources/alphaVantageMarkets.ts). 키를
# 설정해도 아직 동작하지 않는다.
ALPHA_VANTAGE_API_KEY=

# 업비트(코인 BTC/ETH) 공개 시세 API는 인증키가 필요 없다(공개 REST, CORS 허용
# 확인됨) — 브라우저가 직접 호출하므로 여기 등록할 값이 없다.

# ── 재무 브리핑 (scripts/collect-briefing, 기존) ──────────────────────
# FRED_API_KEY / BOK_ECOS_API_KEY / KOSIS_API_KEY — README.md의
# "필요한 GitHub Secrets" 절 참고.
